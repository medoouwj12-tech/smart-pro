DATABASE_URL="postgresql://smartguard:change-me@localhost:5432/smartguard?schema=public"
# For local PostgreSQL, use the same URL as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://smartguard:change-me@localhost:5432/smartguard?schema=public"
# The Neon/Vercel integration provides the pooled DATABASE_URL and direct
# DATABASE_URL_UNPOOLED endpoints automatically.
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this key stable; rotating it without re-encrypting camera passwords makes them unreadable.
CAMERA_CREDENTIALS_KEY="replace-with-a-base64-encoded-32-byte-key"
INITIAL_ADMIN_PASSWORD="replace-with-unique-password-at-least-24-characters"
NEXT_PUBLIC_APP_NAME="SMARTGUARD PRO"
