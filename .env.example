DATABASE_URL="postgresql://smartguard:change-me@localhost:5432/smartguard?schema=public"
# For local PostgreSQL, use the same URL as DATABASE_URL.
DIRECT_URL="postgresql://smartguard:change-me@localhost:5432/smartguard?schema=public"
# On Neon/Vercel, replace DATABASE_URL with the pooled endpoint (hostname includes -pooler)
# and DIRECT_URL with the unpooled endpoint. Get both from Neon Console > Connect.
AUTH_SECRET="replace-with-at-least-32-random-characters"
NEXT_PUBLIC_APP_NAME="SMARTGUARD PRO"
